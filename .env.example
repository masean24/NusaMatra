# Public values only. Everything prefixed with VITE_ is bundled into the browser; never put secrets here.
VITE_APP_NAME=Nusa Matra
# demo | live. Until the separate Data Hub service exists, only `demo` is supported.
VITE_DATA_MODE=demo
# Base URL of the Data Hub API (docs/08-API-SPECIFICATION.md). Leave empty in demo mode.
VITE_API_BASE_URL=
