# Public values only. Everything prefixed with VITE_ is bundled into the browser; never put secrets here.
VITE_APP_NAME=Nusa Matra
# demo | live. `live` needs a verified LIVE Data Hub; until then the Data Hub answers LIVE requests with HTTP 503.
VITE_DATA_MODE=demo
# Origin of the Data Hub API, without /api/v1 (routes already include it). Required for any data panel.
# Browser calls need the API to allow your origin (CORS) and the X-Data-Mode header.
VITE_API_BASE_URL=https://api.orangkeren.me
